# Скопируйте в .env и подставьте значения. Реальные ключи не публикуйте.

# KIE (визуал и часть текстов через контур KIE)
KIE_API_KEY=your_kie_api_key_here

# VseGPT — основной сервис картинок; текст — через KIE, VseGPT только резерв текста
VSEGPT_API_KEY=
# Модели необязательны — подставятся разумные значения по умолчанию
VSEGPT_TEXT_MODEL=anthropic/claude-sonnet-4.6
VSEGPT_IMAGE_MODEL=dall-e-3
# Если VseGPT не ответил за N секунд — картинка через KIE (резерв)
VSEGPT_IMAGE_TIMEOUT_SEC=180

# Yandex OAuth / Wordstat (долгосрочные токены — в .env)
YANDEX_WORDSTAT_CLIENT_ID=
YANDEX_WORDSTAT_CLIENT_SECRET=
YANDEX_WORDSTAT_OAUTH_TOKEN=
YANDEX_WORDSTAT_REFRESH_TOKEN=

# GigaChat (Sber Developers)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Kandinsky / FusionBrain (пока не используем — визуал через KIE)
KANDINSKY_API_KEY=
KANDINSKY_SECRET_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Прямой Claude: резерв текста, если KIE не ответил. Дальше — VseGPT. Пусто = этот шаг пропускается.
ANTHROPIC_API_KEY=

# VK автопубликация
VK_APP_ID=
VK_REDIRECT_URI=https://localhost
# Токен сообщества (из настроек группы)
VK_COMMUNITY_TOKEN=
# Пользовательский токен администратора группы (приоритет над VK_COMMUNITY_TOKEN).
# Права scope: wall, photos, groups, video, offline — через VK OAuth.
VK_USER_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
# Опционально: лимит размера скачиваемого mp4 для video.save (байты), по умолчанию ~450 МБ
# VK_MAX_VIDEO_UPLOAD_BYTES=471859200

# VK Реклама (кабинет https://ads.vk.ru/ → Настройки → Доступ к API)
# Корень API. Пусто = https://ads.vk.ru/api/v2
VK_ADS_BASE_URL=
# Выдача токена. Пусто = {VK_ADS_BASE_URL}/oauth2/token.json
VK_ADS_OAUTH_URL=
# client_id и client_secret — после запроса доступа; secret показывают коротко — сохраните сразу
VK_ADS_CLIENT_ID=
VK_ADS_CLIENT_SECRET=
# access_token — основной ключ для запросов к API (можно также вставить в настройках канала)
VK_ADS_TOKEN=
# синоним (можно заполнить вместо VK_ADS_TOKEN)
VK_ADS_ACCESS_TOKEN=
# refresh_token — чтобы обновлять access_token без повторного входа
VK_ADS_REFRESH_TOKEN=
# unix-время, когда истечёт access_token (приложение пишет само при обновлении)
VK_ADS_TOKEN_EXPIRES_AT=
# необязательно: номер кабинета для заметки / теста по умолчанию
VK_ADS_ACCOUNT_ID=

# --- Безопасность веб-кабинета ---
# Секрет сессий Flask (если пусто — создаётся файл webapp/.secret_key)
FLASK_SECRET_KEY=
# Отдельный ключ шифрования токенов ВК/Ads в БД (если пусто — берётся FLASK_SECRET_KEY)
APP_ENCRYPTION_KEY=
# На HTTPS в проде: 1
SESSION_COOKIE_SECURE=0
# Отладчик Flask. На проде оставьте 0
WEBAPP_DEBUG=0
# 1 — только если перед сайтом стоит ваш прокси (nginx) и он подставляет X-Forwarded-For
TRUST_PROXY=0
# Сколько дней хранить журнал входов (полные IP не пишутся)
SECURITY_LOG_RETENTION_DAYS=180
# Оценка стоимости в отчёте агентства, рубли за одну генерацию
API_COST_ANIMATION_RUB=45
# Режим разработки: вход без логина. На проде ОБЯЗАТЕЛЬНО 0 или удалить строку
WEBAPP_DEV_SKIP_AUTH=0
